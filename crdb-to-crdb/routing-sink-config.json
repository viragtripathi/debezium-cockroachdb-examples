{
  "name": "routing-sink",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics.regex": "crdb\\.public\\.(orders|customers)",
    "connection.url": "jdbc:postgresql://cockroachdb-target:26257/targetdb?sslmode=disable",
    "connection.username": "root",
    "connection.password": "unused",
    "insert.mode": "upsert",
    "delete.enabled": "true",
    "primary.key.mode": "record_key",
    "schema.evolution": "basic",
    "transforms": "routeToTable",
    "transforms.routeToTable.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routeToTable.regex": "crdb\\.public\\.(.*)",
    "transforms.routeToTable.replacement": "public_$1",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true"
  }
}
