{
  "name": "tpcc-source",
  "config": {
    "connector.class": "io.debezium.connector.cockroachdb.CockroachDBConnector",
    "tasks.max": "1",
    "database.hostname": "cockroachdb",
    "database.port": "26257",
    "database.user": "root",
    "database.password": "",
    "database.dbname": "tpcc",
    "database.sslmode": "disable",
    "topic.prefix": "tpcc",
    "table.include.list": "public.warehouse,public.district,public.customer,public.history,public.order,public.new_order,public.item,public.stock,public.order_line",
    "cockroachdb.changefeed.sink.type": "kafka",
    "cockroachdb.changefeed.sink.uri": "kafka://kafka:9092",
    "cockroachdb.changefeed.kafka.bootstrap.servers": "kafka:9092",
    "cockroachdb.changefeed.enriched.properties": "source",
    "cockroachdb.changefeed.kafka.auto.offset.reset": "earliest",
    "cockroachdb.changefeed.resolved.interval": "5s",
    "snapshot.mode": "initial",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true"
  }
}
